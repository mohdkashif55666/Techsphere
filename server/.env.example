# Server environment variables
PORT=5001
NODE_ENV=development

# MongoDB connection string (leave blank to use in-memory MongoDB for local dev)
MONGO_URI=

# JWT secret – change this to a long random string in production
JWT_SECRET=change_me_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d

# Optional: Gemini API key for AI-generated blurbs
# If missing, rule-based fallback text is used – the app works fully without this
GEMINI_API_KEY=

# CORS – set to your deployed client origin in production
CLIENT_ORIGIN=http://localhost:5173
